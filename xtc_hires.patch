+bool XtcReaderActivity::handleZoomButtons() {
+  // On X3, Left/Right are the front navigation pair, Confirm/Back are the other
+  // front pair, Up/Down are the side buttons. Use default side-button assignments
+  // in Settings; user-mapped side actions suppress Up/Down at the input mapper.
+  using B = MappedInputManager::Button;
+  static constexpr B buttons[6] = {B::Left, B::Right, B::Confirm, B::Back, B::Up, B::Down};
+  // A menu can consume a held key's release before we resume; don't let that
+  // suppress the next independent short press.
+  for (int i = 0; i < 6; ++i)
+    if (!mappedInput.isPressed(buttons[i]) && !mappedInput.wasReleased(buttons[i]))
+      suppressZoomRelease[i] = false;
+  for (int i = 0; i < 6; ++i) {
+    if (mappedInput.wasLongPressed(buttons[i], ZOOM_HOLD_MS)) {
+      suppressZoomRelease[i] = true;
+      switch (i) {
+        case 0: changePageBy(-1); break; // Left held: previous
+        case 1: changePageBy(+1); break; // Right held: next
+        case 2: launchMenu(); break;     // Confirm held: menu
+        case 3: onGoHome(); break;       // Back held: leave reader
+        case 4: changePageBy(+1); break; // Side up held: next
+        case 5: changePageBy(-1); break; // Side down held: previous
+      }
+      return true;
+    }
+  }
+  for (int i = 0; i < 6; ++i) {
+    if (mappedInput.wasReleased(buttons[i])) {
+      // X3 front-button transitions can briefly echo onto a side input.
+      if (i >= 4 && !mappedInput.sideReleaseAlone()) return true;
+      const bool wasLong = suppressZoomRelease[i];
+      suppressZoomRelease[i] = false;
+      if (!wasLong) {
+        switch (i) {
+          case 0: panBy(-1, 0); break;
+          case 1: panBy(+1, 0); break;
+          case 2:
+            if (ignoreNextConfirmRelease) ignoreNextConfirmRelease = false;
+            else panBy(0, -1);
+            break;
+          case 3: panBy(0, +1); break;
+          case 4: zoomBy(+1); break;
+          case 5: zoomBy(-1); break;
+        }
+      }
+      return true;
+    }
+  }
+  return false;
+}
+
+// pass 0: any ink (black base); 1: dark gray; 2: any gray.
+// For 1-bit XTC we only need pass 0. For 2-bit XTCH we process source columns
+// in bounded strips, never buffering an entire source plane.
+bool XtcReaderActivity::renderZoomPass(const ZoomViewport& v, uint8_t pass, bool state) {
+  const uint8_t depth = xtc->getBitDepth();
+  if (depth == 1) {
+    if (pass != 0) return true;
+    const size_t rowBytes = (v.pageWidth + 7) / 8;
+    std::vector<uint8_t> rows;
+    // Each group contains at most 12 destination rows (at 2x source, ~24 source rows).
+    for (int dy0 = 0; dy0 < v.dstHeight; dy0 += 12) {
+      const int dy1 = std::min<int>(dy0 + 12, v.dstHeight);
+      int first = v.pageHeight, last = -1;
+      for (int y = dy0; y < dy1; ++y) {
+        const int sy = v.srcY(y);
+        if (sy >= 0 && sy < v.pageHeight) { first = std::min(first, sy); last = std::max(last, sy); }
+      }
+      if (last < first) continue;
+      const size_t start = static_cast<size_t>(first) * rowBytes;
+      const size_t bytes = static_cast<size_t>(last - first + 1) * rowBytes;
+      rows.resize(bytes);
+      size_t copied = 0;
+      const auto err = xtc->loadPageStreaming(currentPage,
+          [&](const uint8_t* data, size_t count, size_t offset) {
+            if (offset >= start && offset - start <= bytes && count <= bytes - (offset - start)) {
+              memcpy(rows.data() + (offset - start), data, count);
+              copied += count;
+            }
+          }, 2048, nullptr, nullptr, start, bytes);
+      if (err != xtc::XtcError::OK || copied != bytes) return false;
+      for (int y = dy0; y < dy1; ++y) {
+        const int sy = v.srcY(y);
+        if (sy < first || sy > last) continue;
+        const uint8_t* row = rows.data() + static_cast<size_t>(sy - first) * rowBytes;
+        for (int x = 0; x < v.dstWidth; ++x) {
+          const int sx = v.srcX(x);
+          if (sx < 0 || sx >= v.pageWidth) continue;
+          if ((row[sx >> 3] & (0x80 >> (sx & 7))) == 0) renderer.drawPixel(x, y, state);
+        }
+      }
+    }
+    return true;
+  }
+
+  const size_t colBytes = (static_cast<size_t>(v.pageHeight) + 7) / 8;
+  const size_t planeSize = static_cast<size_t>(v.pageWidth) * colBytes;
+  std::vector<uint8_t> firstPlane, secondPlane;
+  // 12 destination columns per strip bounds RAM to ~10 KB at 2x resolution.
+  for (int dx0 = 0; dx0 < v.dstWidth; dx0 += 12) {
+    const int dx1 = std::min<int32_t>(dx0 + 12, v.dstWidth);
+    int sourceLo = v.pageWidth, sourceHi = -1;
+    for (int x = dx0; x < dx1; ++x) {
+      const int sx = v.srcX(x);
+      if (sx >= 0 && sx < v.pageWidth) { sourceLo = std::min(sourceLo, sx); sourceHi = std::max(sourceHi, sx); }
+    }
+    if (sourceHi < sourceLo) continue;
+    // Files are physically ordered right-to-left, one byte-column per x.
+    const size_t diskCol = static_cast<size_t>(v.pageWidth - 1 - sourceHi);
+    const size_t nCols = static_cast<size_t>(sourceHi - sourceLo + 1);
+    const size_t start = diskCol * colBytes;
+    const size_t length = nCols * colBytes;
+    firstPlane.resize(length);
+    secondPlane.resize(length);
+    size_t copied0 = 0, copied1 = 0;
+    const auto e0 = xtc->loadPageStreaming(currentPage,
+        [&](const uint8_t* data, size_t count, size_t offset) {
+          if (offset >= start && offset - start <= length && count <= length - (offset - start)) {
+            memcpy(firstPlane.data() + offset - start, data, count); copied0 += count;
+          }
+        }, 2048, nullptr, nullptr, start, length);
+    if (e0 != xtc::XtcError::OK || copied0 != length) return false;
+    const size_t secondStart = planeSize + start;
+    const auto e1 = xtc->loadPageStreaming(currentPage,
+        [&](const uint8_t* data, size_t count, size_t offset) {
+          if (offset >= secondStart && offset - secondStart <= length && count <= length - (offset - secondStart)) {
+            memcpy(secondPlane.data() + offset - secondStart, data, count); copied1 += count;
+          }
+        }, 2048, nullptr, nullptr, secondStart, length);
+    if (e1 != xtc::XtcError::OK || copied1 != length) return false;
+    for (int x = dx0; x < dx1; ++x) {
+      const int sx = v.srcX(x);
+      if (sx < sourceLo || sx > sourceHi) continue;
+      const size_t byteColumn = static_cast<size_t>(sourceHi - sx) * colBytes;
+      for (int y = 0; y < v.dstHeight; ++y) {
+        const int sy = v.srcY(y);
+        if (sy < 0 || sy >= v.pageHeight) continue;
+        const size_t idx = byteColumn + (sy >> 3);
+        const uint8_t mask = static_cast<uint8_t>(0x80 >> (sy & 7));
+        const bool bit1 = (firstPlane[idx] & mask) != 0;
+        const bool bit2 = (secondPlane[idx] & mask) != 0;
+        const bool draw = pass == 0 ? (bit1 || bit2) : (pass == 1 ? (!bit1 && bit2) : (bit1 != bit2));
+        if (draw) renderer.drawPixel(x, y, state);
+      }
+    }
+  }
+  return true;
+}
+
+bool XtcReaderActivity::renderZoomedPage() {
+  const ZoomViewport v = zoomViewport();
+  renderer.clearScreen();
+  if (!renderZoomPass(v, 0, true)) return false;
+  if (xtc->getBitDepth() == 2) {
+    ReaderUtils::displayGrayBaseWithRefreshCycle(renderer, pagesUntilFullRefresh);
+    renderer.clearScreen(0x00);
+    if (!renderZoomPass(v, 1, false)) return false;
+    renderer.copyGrayscaleLsbBuffers();
+    renderer.clearScreen(0x00);
+    if (!renderZoomPass(v, 2, false)) return false;
+    renderer.copyGrayscaleMsbBuffers();
+    renderer.displayGrayBuffer();
+    // Restore the black/white framebuffer (same as the regular XTC renderer).
+    renderer.clearScreen();
+    if (!renderZoomPass(v, 0, true)) return false;
+    renderer.cleanupGrayscaleWithFrameBuffer();
+  } else {
+    // XTC on 2x input: overlay status bar only if selected in settings.
+    if (SETTINGS.statusBarSpec().xtcMode == CrossPointSettings::XTC_STATUS_BAR_MODE::XTC_STATUS_BAR_TOP)
+      renderStatusBarOverlay(StatusBarOverlayPosition::Top);
+    else renderStatusBarOverlay(StatusBarOverlayPosition::Bottom);
+    ReaderUtils::displayWithRefreshCycle(renderer, pagesUntilFullRefresh);
+  }
+  return true;
+}
