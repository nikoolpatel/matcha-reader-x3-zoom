+// High-resolution XTC/XTCH renderer for the X3.  On a 2x page at 100%,
+// viewport maps the whole source to the 528x792 panel; at 200%, pixels
+// are sampled 1:1 from the image.  Never allocate the full 2x page bitmap.
+XtcReaderActivity::ZoomViewport XtcReaderActivity::zoomViewport() const {
+  const int32_t srcW = xtc->getPageWidth(), srcH = xtc->getPageHeight();
+  const int32_t dstW = renderer.getScreenWidth(), dstH = renderer.getScreenHeight();
+  // The fit rect must account for letterboxing, never distort the source aspect.
+  const int32_t fitW = std::max<int32_t>(srcW, (static_cast<int64_t>(srcH) * dstW + dstH - 1) / dstH);
+  const int32_t fitH = std::max<int32_t>(srcH, (static_cast<int64_t>(srcW) * dstH + dstW - 1) / dstW);
+  const uint16_t z = ZOOM_LEVELS[zoomLevelIndex];
+  const int32_t visibleW = std::max<int32_t>(1, (static_cast<int64_t>(fitW) * 100 + z - 1) / z);
+  const int32_t visibleH = std::max<int32_t>(1, (static_cast<int64_t>(fitH) * 100 + z - 1) / z);
+  const int32_t cx = zoomCenterX < 0 ? srcW / 2 : zoomCenterX;
+  const int32_t cy = zoomCenterY < 0 ? srcH / 2 : zoomCenterY;
+  return ZoomViewport{cx - visibleW / 2, cy - visibleH / 2, visibleW, visibleH,
+                      dstW, dstH, srcW, srcH};
+}
+
+void XtcReaderActivity::resetZoomPosition() {
+  if (!xtc) return;
+  zoomCenterX = xtc->getPageWidth() / 2;
+  zoomCenterY = xtc->getPageHeight() / 2;
+}
+
+void XtcReaderActivity::clampZoomPosition() {
+  if (!xtc) return;
+  const ZoomViewport v = zoomViewport();
+  if (v.width >= v.pageWidth) zoomCenterX = v.pageWidth / 2;
+  else zoomCenterX = std::max(v.width / 2, std::min(v.pageWidth - (v.width + 1) / 2, zoomCenterX));
+  if (v.height >= v.pageHeight) zoomCenterY = v.pageHeight / 2;
+  else zoomCenterY = std::max(v.height / 2, std::min(v.pageHeight - (v.height + 1) / 2, zoomCenterY));
+}
+
+void XtcReaderActivity::zoomBy(int amount) {
+  const int idx = std::max(0, std::min(4, static_cast<int>(zoomLevelIndex) + amount));
+  if (idx == zoomLevelIndex) return;
+  zoomLevelIndex = static_cast<uint8_t>(idx);
+  clampZoomPosition();
+  requestUpdate();
+}
+
+void XtcReaderActivity::panBy(int horizontal, int vertical) {
+  if (zoomLevelIndex == 0) return; // 100% fitted page: no panning
+  const ZoomViewport v = zoomViewport();
+  zoomCenterX += horizontal * std::max<int32_t>(1, v.width / 5);
+  zoomCenterY += vertical * std::max<int32_t>(1, v.height / 5);
+  clampZoomPosition();
+  requestUpdate();
+}
+
+void XtcReaderActivity::changePageBy(int direction) {
+  if (!xtc || !xtc->getPageCount()) return;
+  const uint32_t before = currentPage;
+  if (direction < 0) {
+    if (currentPage > 0) --currentPage;
+  } else if (direction > 0 && currentPage < xtc->getPageCount()) {
+    ++currentPage; // existing end-of-book sentinel stays intact
+  }
+  if (currentPage != before) {
+    resetZoomPosition();
+    notePageTurn(direction > 0, true);
+    requestUpdate();
+  }
+}
